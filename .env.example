# Required in production. Generate a long random value (32+ bytes).
SESSION_SECRET=replace-with-a-long-random-secret
# Render PostgreSQL connection string. Use the INTERNAL database URL on Render.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Render commonly requires SSL for external DB connections.
DATABASE_SSL=true
PORT=3000
# Optional comma-separated trusted origins. Leave empty to allow your public site origin.
ALLOWED_ORIGINS=
